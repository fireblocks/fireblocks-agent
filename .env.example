MOBILE_GATEWAY_URL="https://mobile-api.fireblocks.io"
CUSTOMER_SERVER_URL="http://localhost:5000/api"
CUSTOMER_SERVER_AUTHORIZATION="<your-auth-token>"
CUSTOMER_SERVER_PULL_CADENCE_MS=30000
AGENT_REQUESTS_CACHE_SIZE=1024
BROADCAST_BATCH_SIZE=30
# WebSocket push delivery is the default. Set to false to use HTTP long-polling instead.
WEBSOCKET_ENABLED=true
# Optional WebSocket tuning (defaults shown):
# WS_OPEN_TIMEOUT_MS=10000
# WS_MAX_PAYLOAD_BYTES=1048576
# WS_PING_INTERVAL_MS=30000
